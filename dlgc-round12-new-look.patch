diff --git a/src/app/globals.css b/src/app/globals.css
index e5368ce..2f02e90 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -117,6 +117,138 @@
   .prose-club a { @apply link; }
 }
 
+/* ── BANDS ────────────────────────────────────────────────────────────────
+   Pages are broken into full-width bands of tone instead of white cards on
+   grey. A band runs edge to edge; its content stays on the page's normal
+   column, so text lines up with everything above and below it.
+
+   .bleed does that with a margin/padding pair. It makes the element as wide
+   as the window, which is fractionally wider than the page when a scrollbar
+   is showing — the portal layout carries `overflow-x: clip` so that can never
+   become a horizontal scrollbar (CLAUDE.md rule 2). Do not remove either half. */
+@layer components {
+  .bleed {
+    margin-inline: calc(50% - 50vw);
+    padding-inline: calc(50vw - 50%);
+  }
+
+  /* The dark opening band: deep navy, a glow low in the frame like first light
+     over the edge, and the contour drawing behind it all. The drawing is
+     decoration (tools/make-contours.mjs) — it is not a map of anywhere. */
+  .band-dark { @apply bleed; }
+  /* .ground-dark is the same surface without the bleed, for an element that
+     is already full width (the sign-in page). */
+  .band-dark,
+  .ground-dark {
+    @apply relative text-white;
+    isolation: isolate;
+    background-color: #0C2D49;
+    background-image:
+      radial-gradient(80% 110% at 88% 118%, rgba(217, 112, 43, 0.30), transparent 62%),
+      radial-gradient(70% 90% at 0% 0%, rgba(31, 111, 168, 0.45), transparent 65%);
+  }
+  .band-dark::before,
+  .ground-dark::before {
+    content: '';
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    background: url('/img/contours-dark.svg') center / cover no-repeat;
+    opacity: 0.26;
+    pointer-events: none;
+  }
+
+  /* Light bands. White and cloud alternate down a page; the contour variant
+     is for the one or two bands per page that deserve a little more. */
+  .band-white { @apply bleed bg-white; }
+  .band-cloud { @apply bleed bg-cloud; }
+  .band-contour { @apply bleed; }
+  /* .ground-contour: the same surface without the bleed (the footer). */
+  .band-contour,
+  .ground-contour {
+    @apply relative bg-cloud;
+    isolation: isolate;
+  }
+  .band-contour::before,
+  .ground-contour::before {
+    content: '';
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    background: url('/img/contours-light.svg') center / cover no-repeat;
+    opacity: 0.07;
+    pointer-events: none;
+  }
+
+  /* <Section> — see ui.tsx. A direct child of the page is a band; white and
+     cloud alternate by position. `:nth-child(… of .sec)` is ignored by browsers
+     older than 2023, where every band is simply white: still correct, just
+     less varied. */
+  .sec { margin-bottom: 2.5rem; scroll-margin-top: 1rem; }
+  main > .sec {
+    margin-bottom: 0;
+    margin-inline: calc(50% - 50vw);
+    padding-inline: calc(50vw - 50%);
+    padding-block: 2.75rem;
+    background-color: #fff;
+  }
+  main > .sec:nth-child(even of .sec) { @apply bg-cloud; }
+  @media (min-width: 1024px) { main > .sec { padding-block: 3.5rem; } }
+
+  /* A band that ends a page runs down to the footer, and whatever follows a
+     page header that is not itself a band gets room to breathe. */
+  main > .sec:last-child,
+  main > [class*='band-']:last-child { margin-bottom: -2rem; }
+  @media (min-width: 1024px) {
+    main > .sec:last-child,
+    main > [class*='band-']:last-child { margin-bottom: -2.5rem; }
+  }
+  main > .page-head + *:not(.sec):not([class*='band-']) { margin-top: 2rem; }
+  main > .sec + *:not(.sec):not([class*='band-']) { margin-top: 2rem; }
+  main > *:not(.sec):not([class*='band-']) + .sec { margin-top: 2rem; }
+
+  /* Display type: page titles and band headings. The <em> is the phrase picked
+     out in italic — windsock orange on a dark band, sky on a light one. */
+  .display {
+    @apply font-display;
+    font-weight: 560;
+    letter-spacing: -0.012em;
+    line-height: 1.06;
+    font-feature-settings: 'kern' 1, 'liga' 1, 'lnum' 1;
+  }
+  .display em {
+    font-style: italic;
+    font-weight: 470;
+    @apply text-skyDark;
+  }
+  .band-dark .display,
+  .ground-dark .display { @apply text-white; }
+  .band-dark .display em,
+  .ground-dark .display em { @apply text-windsock; }
+
+  /* Big figures with a small label under each. */
+  .figure {
+    @apply font-display;
+    font-weight: 560;
+    letter-spacing: -0.012em;
+    line-height: 1;
+    white-space: nowrap;
+    font-feature-settings: 'lnum' 1;
+  }
+
+  /* Pill buttons — the primary actions on a band. 48px tall for cold hands. */
+  .pill {
+    @apply inline-flex min-h-[48px] items-center gap-2 rounded-full px-5 py-2.5 font-semibold transition-colors;
+  }
+  .pill-accent { @apply pill bg-windsock text-deep hover:bg-white; }
+  .pill-ghost { @apply pill border border-white/55 text-white hover:border-white hover:bg-white/10; }
+  .pill-solid { @apply pill bg-navy text-white hover:bg-skyDark; }
+  .pill-line { @apply pill border border-navy/40 text-navy hover:border-navy hover:bg-white; }
+
+  .band-dark :focus-visible,
+  .ground-dark :focus-visible { outline-color: #F2A65A; }
+}
+
 @media (prefers-reduced-motion: reduce) {
   *, *::before, *::after {
     animation-duration: 0.01ms !important;
diff --git a/src/app/layout.tsx b/src/app/layout.tsx
index 66e5a9a..defa2c9 100644
--- a/src/app/layout.tsx
+++ b/src/app/layout.tsx
@@ -51,6 +51,30 @@ const plexMono = localFont({
   fallback: ['ui-monospace', 'SFMono-Regular', 'Menlo', 'Consolas', 'monospace'],
 });
 
+/**
+ * DISPLAY FACE — Newsreader, self-hosted, for page titles and band headings only.
+ *
+ * Plex stays the working face for everything a member reads or presses.
+ * Newsreader is here for the few large lines that give a page its character,
+ * and for the italic phrase picked out in each title. It was chosen over more
+ * decorative faces because its italic stays easy to read and its figures are
+ * plain lining figures — "26Q4" and "20 Nov" have to read at a glance.
+ *
+ * Two fixed cuts taken from the variable font at its display optical size: a
+ * roman at weight 560 and an italic at 470. 50 KB for the pair. Never use it
+ * below 1.5rem.
+ */
+const display = localFont({
+  src: [
+    { path: './fonts/newsreader-latin-display-normal.woff2', weight: '560', style: 'normal' },
+    { path: './fonts/newsreader-latin-display-italic.woff2', weight: '470', style: 'italic' },
+  ],
+  display: 'swap',
+  variable: '--font-display',
+  adjustFontFallback: 'Times New Roman',
+  fallback: ['Georgia', 'Times New Roman', 'serif'],
+});
+
 export const metadata: Metadata = {
   title: {
     default: "DLGC Members' Portal",
@@ -71,7 +95,7 @@ export const viewport: Viewport = {
 
 export default function RootLayout({ children }: { children: React.ReactNode }) {
   return (
-    <html lang="en-GB" className={`${plexSans.variable} ${plexMono.variable}`}>
+    <html lang="en-GB" className={`${plexSans.variable} ${plexMono.variable} ${display.variable}`}>
       <body>{children}</body>
     </html>
   );
